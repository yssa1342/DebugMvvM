<UserControl x:Class="DebugMvvM.App.Views.GJ750_4_60AView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DebugMvvM.App.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Device Header -->
        <Border Grid.Row="0" Background="#ECF0F1" Padding="15" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Foreground="#2C3E50"/>
                    <TextBlock Text="{Binding Device.DeviceName}" FontSize="14" Foreground="#7F8C8D" Margin="0,5,0,0"/>
                    <TextBlock Text="{Binding ConnectionStatus}" FontSize="12" Foreground="#27AE60" Margin="0,5,0,0"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Connect" 
                           Command="{Binding ConnectCommand}"
                           IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBoolConverter}}"
                           Width="100" 
                           Height="35" 
                           Margin="5"
                           Background="#27AE60"
                           Foreground="White"
                           BorderThickness="0"
                           Cursor="Hand"/>
                    
                    <Button Content="Disconnect" 
                           Command="{Binding DisconnectCommand}"
                           IsEnabled="{Binding IsConnected}"
                           Width="100" 
                           Height="35" 
                           Margin="5"
                           Background="#E74C3C"
                           Foreground="White"
                           BorderThickness="0"
                           Cursor="Hand"/>
                    
                    <Button Content="Read Data" 
                           Command="{Binding ReadDataCommand}"
                           IsEnabled="{Binding IsConnected}"
                           Width="100" 
                           Height="35" 
                           Margin="5"
                           Background="#3498DB"
                           Foreground="White"
                           BorderThickness="0"
                           Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Device Data Display -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Channel 1 & 2 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Channel 1 -->
                    <Border Grid.Column="0" Background="#3498DB" Padding="15" Margin="5" CornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="Channel 1" FontSize="16" Foreground="White" FontWeight="Bold"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Voltage" FontSize="12" Foreground="White"/>
                                    <TextBlock Text="{Binding Device.Channel1Voltage, StringFormat={}{0:F2} V}" 
                                              FontSize="20" Foreground="White" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Current" FontSize="12" Foreground="White"/>
                                    <TextBlock Text="{Binding Device.Channel1Current, StringFormat={}{0:F2} A}" 
                                              FontSize="20" Foreground="White" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    
                    <!-- Channel 2 -->
                    <Border Grid.Column="1" Background="#E67E22" Padding="15" Margin="5" CornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="Channel 2" FontSize="16" Foreground="White" FontWeight="Bold"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Voltage" FontSize="12" Foreground="White"/>
                                    <TextBlock Text="{Binding Device.Channel2Voltage, StringFormat={}{0:F2} V}" 
                                              FontSize="20" Foreground="White" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Current" FontSize="12" Foreground="White"/>
                                    <TextBlock Text="{Binding Device.Channel2Current, StringFormat={}{0:F2} A}" 
                                              FontSize="20" Foreground="White" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
                
                <!-- Channel 3 & 4 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Channel 3 -->
                    <Border Grid.Column="0" Background="#9B59B6" Padding="15" Margin="5" CornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="Channel 3" FontSize="16" Foreground="White" FontWeight="Bold"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Voltage" FontSize="12" Foreground="White"/>
                                    <TextBlock Text="{Binding Device.Channel3Voltage, StringFormat={}{0:F2} V}" 
                                              FontSize="20" Foreground="White" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Current" FontSize="12" Foreground="White"/>
                                    <TextBlock Text="{Binding Device.Channel3Current, StringFormat={}{0:F2} A}" 
                                              FontSize="20" Foreground="White" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    
                    <!-- Channel 4 -->
                    <Border Grid.Column="1" Background="#1ABC9C" Padding="15" Margin="5" CornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="Channel 4" FontSize="16" Foreground="White" FontWeight="Bold"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Voltage" FontSize="12" Foreground="White"/>
                                    <TextBlock Text="{Binding Device.Channel4Voltage, StringFormat={}{0:F2} V}" 
                                              FontSize="20" Foreground="White" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Current" FontSize="12" Foreground="White"/>
                                    <TextBlock Text="{Binding Device.Channel4Current, StringFormat={}{0:F2} A}" 
                                              FontSize="20" Foreground="White" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
                
                <!-- Total Power & Temperature -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Grid.Column="0" Background="#E74C3C" Padding="20" Margin="5" CornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="Total Power" FontSize="16" Foreground="White" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Device.TotalPower, StringFormat={}{0:F2} W}" 
                                      FontSize="28" Foreground="White" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Grid.Column="1" Background="#F39C12" Padding="20" Margin="5" CornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="Temperature" FontSize="16" Foreground="White" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Device.Temperature, StringFormat={}{0:F1} °C}" 
                                      FontSize="28" Foreground="White" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
                
                <!-- Status -->
                <Border Grid.Row="3" Background="#27AE60" Padding="20" Margin="5" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="Device Status" FontSize="16" Foreground="White" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Device.Status}" 
                                  FontSize="20" Foreground="White" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- Device Info -->
                <Border Grid.Row="4" Background="#34495E" Padding="15" Margin="5" CornerRadius="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Device ID:" 
                                  Foreground="White" Margin="5" FontWeight="Bold"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Device.DeviceId}" 
                                  Foreground="White" Margin="5"/>
                        
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Device Type:" 
                                  Foreground="White" Margin="5" FontWeight="Bold"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Device.DeviceType}" 
                                  Foreground="White" Margin="5"/>
                        
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Active Channels:" 
                                  Foreground="White" Margin="5" FontWeight="Bold"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Device.ActiveChannels}" 
                                  Foreground="White" Margin="5"/>
                        
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Last Communication:" 
                                  Foreground="White" Margin="5" FontWeight="Bold"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" 
                                  Text="{Binding Device.LastCommunicationTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" 
                                  Foreground="White" Margin="5"/>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
