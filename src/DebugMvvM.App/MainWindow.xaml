<Window x:Class="DebugMvvM.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DebugMvvM.App"
        xmlns:views="clr-namespace:DebugMvvM.App.Views"
        xmlns:vm="clr-namespace:DebugMvvM.ViewModels;assembly=DebugMvvM.ViewModels"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <!-- DataTemplate for Vdc32ViewModel -->
        <DataTemplate DataType="{x:Type vm:Vdc32ViewModel}">
            <views:Vdc32View />
        </DataTemplate>
        
        <!-- DataTemplate for GJ750_4_60AViewModel -->
        <DataTemplate DataType="{x:Type vm:GJ750_4_60AViewModel}">
            <views:GJ750_4_60AView />
        </DataTemplate>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="15">
            <TextBlock Text="{Binding Title}" 
                      FontSize="24" 
                      FontWeight="Bold" 
                      Foreground="White"
                      HorizontalAlignment="Center"/>
        </Border>
        
        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Navigation Panel -->
            <Border Grid.Column="0" Background="#34495E" Padding="10">
                <StackPanel>
                    <TextBlock Text="Device Selection" 
                              FontSize="16" 
                              FontWeight="Bold" 
                              Foreground="White" 
                              Margin="0,0,0,15"/>
                    
                    <Button Content="Vdc_32 Device" 
                           Command="{Binding SwitchToVdc32Command}"
                           Margin="0,5" 
                           Padding="10"
                           Background="#3498DB"
                           Foreground="White"
                           BorderThickness="0"
                           Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                   CornerRadius="5" 
                                                   Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2980B9"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    
                    <Button Content="GJ750_4_60A Device" 
                           Command="{Binding SwitchToGJ750Command}"
                           Margin="0,5" 
                           Padding="10"
                           Background="#3498DB"
                           Foreground="White"
                           BorderThickness="0"
                           Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                   CornerRadius="5" 
                                                   Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2980B9"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
            
            <!-- Content Area -->
            <Border Grid.Column="1" Background="White" Padding="10">
                <ContentControl Content="{Binding CurrentViewModel}"/>
            </Border>
        </Grid>
        
        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#34495E" Padding="10">
            <TextBlock Text="Ready" Foreground="White"/>
        </Border>
    </Grid>
</Window>
